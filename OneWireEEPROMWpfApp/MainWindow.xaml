<Window x:Class="OneWireEEPROMWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:OneWireEEPROMWpfApp.Views"
        xmlns:nlogViewer="clr-namespace:NlogViewer;assembly=NlogViewer"
        mc:Ignorable="d"
        Title="1-Wire EEPROM Test Tool" Height="800" Width="765">
    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Load JSON"
                          Command="{Binding LoadJsonCommand}" />
                <MenuItem Header="_Save JSON"
                          Command="{Binding SaveJsonCommand}" />
                <MenuItem Header="_Export Raw Data"
                          Command="{Binding ExportHexCommand}" />
            </MenuItem>
        </Menu>

        <StackPanel DockPanel.Dock="Top">
            <views:EepromDataView/>
        </StackPanel>

        <nlogViewer:NlogViewer x:Name="logCtrl" MinHeight="320" TimeWidth="auto" LoggerNameWidth="auto"
                               LevelWidth="auto"
                               ExceptionWidth="auto" MessageWidth="450" FontSize="11" />
    </DockPanel>

</Window>

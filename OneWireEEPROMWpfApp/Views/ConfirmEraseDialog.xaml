<Window x:Class="OneWireEEPROMWpfApp.Views.ConfirmEraseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Erase"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Erase the entire EEPROM?"
                   TextWrapping="Wrap"
                   FontSize="14" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Cancel" Width="80" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Confirm" Width="80" IsDefault="True" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>

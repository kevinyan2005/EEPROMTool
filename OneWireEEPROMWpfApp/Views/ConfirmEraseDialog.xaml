<Window x:Class="OneWireEEPROMWpfApp.Views.ConfirmEraseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Erase"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
    
     
        Background="#77000000">
    <Grid>
        <Border Width="320"
                Padding="16"
                Background="White"
                BorderBrush="#404040"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--<TextBlock Grid.Row="0"
                           Text="Confirm Erase"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />-->

                <TextBlock Grid.Row="2"
                           Text="Erase the entire EEPROM?"
                           TextWrapping="Wrap"
                           FontSize="14"
                           TextAlignment="Center" />

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Cancel" Width="90" IsCancel="True" Margin="0,0,8,0" />
                    <Button Content="Confirm" Width="90" IsDefault="True" Click="Confirm_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

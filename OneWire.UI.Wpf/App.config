<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="slf4net" type="slf4net.Configuration.SlfConfigurationSection, slf4net" />
  </configSections>
  <appSettings>
    <add key="AdapterType" value="MRPCB" />    <!-- AdapterType enum, e.g. DS9490, DCT, MRPCB, Mock-->
    <add key="ApplicationMode" value="Production" />    <!-- ApplicationMode enum: Developer (all advanced features enabled) or Production (all advanced features disabled) -->
    <add key="ShowOverdriveCheckbox" value="false" />
    <add key="ShowProbeUsageDate" value="false" />
    <add key="EraseFillByte" value="0xFF" />
    <add key="UserDataVersion" value="1" />
  </appSettings>
  
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="NLog" publicKeyToken="5120e14c03d0593c" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="slf4net" publicKeyToken="592edb3b6b36b5ba" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-0.1.32.1" newVersion="0.1.32.1" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
<slf4net>
    <factory type="slf4net.NLog.NLogLoggerFactory, slf4net.NLog" />
  </slf4net></configuration>

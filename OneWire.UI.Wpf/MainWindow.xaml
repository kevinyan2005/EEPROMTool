<Window x:Class="OneWire.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:OneWire.UI.Wpf.Views"
        xmlns:nlogViewer="clr-namespace:NlogViewer;assembly=NlogViewer"
        mc:Ignorable="d"
        Title="1-Wire EEPROM Test Tool" Height="800" Width="860">
    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Import">
                    <MenuItem Header="_Load JSON"
                              Command="{Binding LoadJsonCommand}" />
                    <MenuItem Header="Load RAW _txt"
                              Command="{Binding LoadRawTxtCommand}" />
                </MenuItem>
                <MenuItem Header="_Export">
                    <MenuItem Header="_Save JSON"
                              Command="{Binding SaveJsonCommand}" />
                    <MenuItem Header="Save _RAW txt"
                              Command="{Binding SaveRawTxtCommand}" />
                    <MenuItem Header="Save _Hex Dump"
                              Command="{Binding ExportHexCommand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit"
                          Command="{Binding ExitCommand}" />
            </MenuItem>
        </Menu>

        <StackPanel DockPanel.Dock="Top">
            <views:EepromDataView/>
        </StackPanel>

        <nlogViewer:NlogViewer x:Name="logCtrl" MinHeight="300" TimeWidth="auto" LoggerNameWidth="auto"
                               LevelWidth="auto"
                               ExceptionWidth="auto" MessageWidth="450" FontSize="11" />
    </DockPanel>

</Window>

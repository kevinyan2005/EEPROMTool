<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="IconStrokeBrush" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="IconAccentBrush" Color="#FF2F6FED" />
    <SolidColorBrush x:Key="IconDangerBrush" Color="#FFD32F2F" />

    <!-- Shared EEPROM chip glyph (DIP package outline + pins + pin-1 notch), reused across all toolbar icons -->
    <Canvas x:Key="EepromChipGlyph" x:Shared="False" Width="24" Height="24">
        <Rectangle Canvas.Left="5" Canvas.Top="8" Width="14" Height="12"
                   RadiusX="1.5" RadiusY="1.5"
                   Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" Fill="White" />
        <Line X1="2" Y1="10" X2="5" Y2="10" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="2" Y1="14" X2="5" Y2="14" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="2" Y1="18" X2="5" Y2="18" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="19" Y1="10" X2="22" Y2="10" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="19" Y1="14" X2="22" Y2="14" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="19" Y1="18" X2="22" Y2="18" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Path Data="M 10,8 A 2,2 0 0 0 14,8" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.2" Fill="White" />
    </Canvas>

    <!-- Solid blue-filled chip glyph: used for "write entire EEPROM" to signal the whole chip is being programmed -->
    <Canvas x:Key="EepromChipGlyphAccentFilled" x:Shared="False" Width="24" Height="24">
        <Rectangle Canvas.Left="5" Canvas.Top="8" Width="14" Height="12"
                   RadiusX="1.5" RadiusY="1.5"
                   Stroke="{StaticResource IconAccentBrush}" StrokeThickness="1.3" Fill="{StaticResource IconAccentBrush}" />
        <Line X1="2" Y1="10" X2="5" Y2="10" Stroke="{StaticResource IconAccentBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="2" Y1="14" X2="5" Y2="14" Stroke="{StaticResource IconAccentBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="2" Y1="18" X2="5" Y2="18" Stroke="{StaticResource IconAccentBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="19" Y1="10" X2="22" Y2="10" Stroke="{StaticResource IconAccentBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="19" Y1="14" X2="22" Y2="14" Stroke="{StaticResource IconAccentBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="19" Y1="18" X2="22" Y2="18" Stroke="{StaticResource IconAccentBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Path Data="M 10,8 A 2,2 0 0 0 14,8" Stroke="{StaticResource IconAccentBrush}" StrokeThickness="1.2" Fill="White" />
    </Canvas>

    <!-- Solid red-filled chip glyph: used for "format EEPROM" to signal a destructive full-chip operation -->
    <Canvas x:Key="EepromChipGlyphDangerFilled" x:Shared="False" Width="24" Height="24">
        <Rectangle Canvas.Left="5" Canvas.Top="8" Width="14" Height="12"
                   RadiusX="1.5" RadiusY="1.5"
                   Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.3" Fill="{StaticResource IconDangerBrush}" />
        <Line X1="2" Y1="10" X2="5" Y2="10" Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="2" Y1="14" X2="5" Y2="14" Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="2" Y1="18" X2="5" Y2="18" Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="19" Y1="10" X2="22" Y2="10" Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="19" Y1="14" X2="22" Y2="14" Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="19" Y1="18" X2="22" Y2="18" Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Path Data="M 10,8 A 2,2 0 0 0 14,8" Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.2" Fill="White" />
    </Canvas>

    <!-- Shared floppy disk glyph (casing + folded corner + metal shutter + label), same footprint as EepromChipGlyph -->
    <Canvas x:Key="FloppyDiskGlyph" x:Shared="False" Width="24" Height="24">
        <Rectangle Canvas.Left="5" Canvas.Top="8" Width="14" Height="12"
                   RadiusX="1.3" RadiusY="1.3"
                   Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" Fill="White" />
        <Line X1="15.5" Y1="8" X2="19" Y2="11.5"
              Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Rectangle Canvas.Left="8.5" Canvas.Top="8" Width="7" Height="4"
                   Fill="{StaticResource IconStrokeBrush}" />
        <Rectangle Canvas.Left="7.5" Canvas.Top="14.5" Width="9" Height="4.5"
                   RadiusX="0.6" RadiusY="0.6"
                   Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1" Fill="White" />
    </Canvas>

    <!-- Save EEPROM image: floppy disk with a bold downward arrow (application -> raw .txt file) -->
    <Button x:Key="SaveRawTxtIconButton" x:Shared="False"
            Width="32" Height="32" Padding="0" Margin="0"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="Save the current EEPROM image to a raw .txt file"
            Command="{Binding SaveRawTxtCommand}"
            AutomationProperties.AutomationId="SaveRawTxtButton">
        <Viewbox Width="22" Height="22">
            <Grid Width="24" Height="24">
                <ContentControl Content="{StaticResource FloppyDiskGlyph}" Focusable="False" IsTabStop="False" />
                <Canvas Width="24" Height="24">
                    <Line X1="12" Y1="0.5" X2="12" Y2="3.5"
                          Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="2.4" StrokeEndLineCap="Round" />
                    <Polygon Points="7,3.5 12,8 17,3.5"
                             Fill="{StaticResource IconStrokeBrush}" />
                </Canvas>
            </Grid>
        </Viewbox>
    </Button>

    <!-- Clear EEPROM image: trash can glyph, clears the currently displayed EEPROM data without touching the device -->
    <Button x:Key="ClearEepromDataIconButton" x:Shared="False"
            Width="32" Height="32" Padding="0" Margin="0"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="Clear the currently displayed EEPROM data image"
            Command="{Binding ClearEepromDataCommand}"
            AutomationProperties.AutomationId="ClearEepromDataButton">
        <Viewbox Width="22" Height="22">
            <Canvas Width="24" Height="24">
                <Rectangle Canvas.Left="9" Canvas.Top="3" Width="6" Height="2" RadiusX="1" RadiusY="1"
                           Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.3" Fill="White" />
                <Line X1="5" Y1="7" X2="19" Y2="7"
                      Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Polygon Points="6.5,7 17.5,7 16.5,20 7.5,20"
                         Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.4" Fill="White" />
                <Line X1="9.5" Y1="10" X2="9.7" Y2="17"
                      Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line X1="12" Y1="10" X2="12" Y2="17"
                      Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line X1="14.5" Y1="10" X2="14.3" Y2="17"
                      Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
        </Viewbox>
    </Button>

    <!-- Load EEPROM image: floppy disk with a bold upward arrow (raw .txt file -> application) -->
    <Button x:Key="LoadRawTxtIconButton" x:Shared="False"
            Width="32" Height="32" Padding="0" Margin="0"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="Load an EEPROM image from a raw .txt file"
            Command="{Binding LoadRawTxtCommand}"
            AutomationProperties.AutomationId="LoadRawTxtButton">
        <Viewbox Width="22" Height="22">
            <Grid Width="24" Height="24">
                <ContentControl Content="{StaticResource FloppyDiskGlyph}" Focusable="False" IsTabStop="False" />
                <Canvas Width="24" Height="24">
                    <Line X1="12" Y1="8" X2="12" Y2="5"
                          Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" />
                    <Polygon Points="7,5 12,0.5 17,5"
                             Fill="{StaticResource IconStrokeBrush}" />
                </Canvas>
            </Grid>
        </Viewbox>
    </Button>

    <!-- Read EEPROM: chip with a bold upward arrow (device -> PC) -->
    <Button x:Key="ReadEepromIconButton" x:Shared="False"
            Width="32" Height="32" Padding="0" Margin="0"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="Read entire EEPROM from the device into the application"
            Command="{Binding ReadEepromCommand}"
            AutomationProperties.AutomationId="ReadEepromButton">
        <Viewbox Width="22" Height="22">
            <Grid Width="24" Height="24">
                <ContentControl Content="{StaticResource EepromChipGlyph}" Focusable="False" IsTabStop="False" />
                <Canvas Width="24" Height="24">
                    <Line X1="12" Y1="8" X2="12" Y2="5"
                          Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" />
                    <Polygon Points="7,5 12,0.5 17,5"
                             Fill="{StaticResource IconStrokeBrush}" />
                </Canvas>
            </Grid>
        </Viewbox>
    </Button>

    <!-- Format EEPROM: solid red chip with a bold red downward arrow (same shape as Write Entire), fills EEPROM with 0xFF -->
    <Button x:Key="FormatEepromIconButton" x:Shared="False"
            Width="32" Height="32" Padding="0" Margin="0"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="Format EEPROM - fills the entire chip with 0xFF"
            Command="{Binding EraseEepromCommand}"
            AutomationProperties.AutomationId="FormatEepromButton">
        <Viewbox Width="22" Height="22">
            <Grid Width="24" Height="24">
                <ContentControl Content="{StaticResource EepromChipGlyphDangerFilled}" Focusable="False" IsTabStop="False" />
                <Canvas Width="24" Height="24">
                    <Line X1="12" Y1="0.5" X2="12" Y2="3.5"
                          Stroke="{StaticResource IconDangerBrush}" StrokeThickness="2.4" StrokeEndLineCap="Round" />
                    <Polygon Points="7,3.5 12,8 17,3.5"
                             Fill="{StaticResource IconDangerBrush}" />
                </Canvas>
            </Grid>
        </Viewbox>
    </Button>

    <!-- Write Entire EEPROM: solid blue chip with a bold blue downward arrow (PC -> device), spanning the whole chip -->
    <Button x:Key="WriteEntireEepromIconButton" x:Shared="False"
            Width="32" Height="32" Padding="0" Margin="0"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="Write the entire EEPROM (all sections) from the application to the device"
            Command="{Binding WriteEntireEepromCommand}"
            AutomationProperties.AutomationId="WriteEntireEepromButton">
        <Viewbox Width="22" Height="22">
            <Grid Width="24" Height="24">
                <ContentControl Content="{StaticResource EepromChipGlyphAccentFilled}" Focusable="False" IsTabStop="False" />
                <Canvas Width="24" Height="24">
                    <Line X1="12" Y1="0.5" X2="12" Y2="3.5"
                          Stroke="{StaticResource IconAccentBrush}" StrokeThickness="2.4" StrokeEndLineCap="Round" />
                    <Polygon Points="7,3.5 12,8 17,3.5"
                             Fill="{StaticResource IconAccentBrush}" />
                </Canvas>
            </Grid>
        </Viewbox>
    </Button>

    <!-- Write User Data Only: chip with a bold centered downward arrow and a highlighted sub-section -->
    <Button x:Key="WriteUserDataIconButton" x:Shared="False"
            Width="32" Height="32" Padding="0" Margin="0,0,5,0"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="Write only the User Data section to the device"
            Command="{Binding WriteUserDataCommand}"
            AutomationProperties.AutomationId="WriteUserDataButton">
        <Viewbox Width="22" Height="22">
            <Grid Width="24" Height="24">
                <ContentControl Content="{StaticResource EepromChipGlyph}" Focusable="False" IsTabStop="False" />
                <Canvas Width="24" Height="24">
                    <Rectangle Width="5" Height="5" Canvas.Left="13" Canvas.Top="14"
                               RadiusX="0.8" RadiusY="0.8"
                               Fill="{StaticResource IconAccentBrush}" />
                    <Line X1="12" Y1="0.5" X2="12" Y2="3.5"
                          Stroke="{StaticResource IconAccentBrush}" StrokeThickness="2.4" StrokeEndLineCap="Round" />
                    <Polygon Points="7,3.5 12,8 17,3.5"
                             Fill="{StaticResource IconAccentBrush}" />
                </Canvas>
            </Grid>
        </Viewbox>
    </Button>

</ResourceDictionary>

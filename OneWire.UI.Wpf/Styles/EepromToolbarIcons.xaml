<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="IconStrokeBrush" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="IconAccentBrush" Color="#FF2F6FED" />
    <SolidColorBrush x:Key="IconDangerBrush" Color="#FFD32F2F" />

    <!-- Shared EEPROM chip glyph (DIP package outline + pins + pin-1 notch), reused across all toolbar icons -->
    <Canvas x:Key="EepromChipGlyph" x:Shared="False" Width="24" Height="24">
        <Rectangle Canvas.Left="5" Canvas.Top="8" Width="14" Height="12"
                   RadiusX="1.5" RadiusY="1.5"
                   Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" Fill="White" />
        <Line X1="2" Y1="10" X2="5" Y2="10" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="2" Y1="14" X2="5" Y2="14" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="2" Y1="18" X2="5" Y2="18" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="19" Y1="10" X2="22" Y2="10" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="19" Y1="14" X2="22" Y2="14" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Line X1="19" Y1="18" X2="22" Y2="18" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Path Data="M 8,8 A 2,2 0 0 0 12,8" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.2" Fill="White" />
    </Canvas>

    <!-- Read EEPROM: chip with a bold upward arrow (device -> PC) -->
    <Button x:Key="ReadEepromIconButton" x:Shared="False"
            Width="32" Height="32" Padding="0" Margin="0"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="Read entire EEPROM from the device into the application"
            Command="{Binding ReadEepromCommand}"
            AutomationProperties.AutomationId="ReadEepromButton">
        <Viewbox Width="22" Height="22">
            <Grid Width="24" Height="24">
                <ContentControl Content="{StaticResource EepromChipGlyph}" Focusable="False" IsTabStop="False" />
                <Canvas Width="24" Height="24">
                    <Line X1="12" Y1="8" X2="12" Y2="5"
                          Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" />
                    <Polygon Points="7,5 12,0.5 17,5"
                             Fill="{StaticResource IconStrokeBrush}" />
                </Canvas>
            </Grid>
        </Viewbox>
    </Button>

    <!-- Format EEPROM: chip with a bold red downward arrow plus a red eraser, fills EEPROM with 0xFF -->
    <Button x:Key="FormatEepromIconButton" x:Shared="False"
            Width="32" Height="32" Padding="0" Margin="0"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="Format EEPROM - fills the entire chip with 0xFF"
            Command="{Binding EraseEepromCommand}"
            AutomationProperties.AutomationId="FormatEepromButton">
        <Viewbox Width="22" Height="22">
            <Grid Width="24" Height="24">
                <ContentControl Content="{StaticResource EepromChipGlyph}" Focusable="False" IsTabStop="False" />
                <Canvas Width="24" Height="24">
                    <Line X1="12" Y1="0.5" X2="12" Y2="3.5"
                          Stroke="{StaticResource IconDangerBrush}" StrokeThickness="2.4" StrokeEndLineCap="Round" />
                    <Polygon Points="7,3.5 12,8 17,3.5"
                             Fill="{StaticResource IconDangerBrush}" />
                    <Rectangle Width="9" Height="5.5" Canvas.Left="13.5" Canvas.Top="14.5"
                               RadiusX="1.2" RadiusY="1.2"
                               Fill="{StaticResource IconDangerBrush}"
                               RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="35" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Line X1="6" Y1="15" X2="8.5" Y2="12.5"
                          Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.1"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.6" />
                    <Line X1="8.5" Y1="17" X2="11" Y2="14.5"
                          Stroke="{StaticResource IconDangerBrush}" StrokeThickness="1.1"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.6" />
                </Canvas>
            </Grid>
        </Viewbox>
    </Button>

    <!-- Write Entire EEPROM: chip with a bold downward arrow (PC -> device), spanning the whole chip -->
    <Button x:Key="WriteEntireEepromIconButton" x:Shared="False"
            Width="32" Height="32" Padding="0" Margin="0"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="Write the entire EEPROM (all sections) from the application to the device"
            Command="{Binding WriteEntireEepromCommand}"
            AutomationProperties.AutomationId="WriteEntireEepromButton">
        <Viewbox Width="22" Height="22">
            <Grid Width="24" Height="24">
                <ContentControl Content="{StaticResource EepromChipGlyph}" Focusable="False" IsTabStop="False" />
                <Canvas Width="24" Height="24">
                    <Line X1="12" Y1="0.5" X2="12" Y2="3.5"
                          Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="2.4" StrokeEndLineCap="Round" />
                    <Polygon Points="7,3.5 12,8 17,3.5"
                             Fill="{StaticResource IconStrokeBrush}" />
                </Canvas>
            </Grid>
        </Viewbox>
    </Button>

    <!-- Write User Data Only: chip with a bold centered downward arrow and a highlighted sub-section -->
    <Button x:Key="WriteUserDataIconButton" x:Shared="False"
            Width="32" Height="32" Padding="0" Margin="0,0,5,0"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="Write only the User Data section to the device"
            Command="{Binding WriteUserDataCommand}"
            AutomationProperties.AutomationId="WriteUserDataButton">
        <Viewbox Width="22" Height="22">
            <Grid Width="24" Height="24">
                <ContentControl Content="{StaticResource EepromChipGlyph}" Focusable="False" IsTabStop="False" />
                <Canvas Width="24" Height="24">
                    <Rectangle Width="5" Height="5" Canvas.Left="13" Canvas.Top="14"
                               RadiusX="0.8" RadiusY="0.8"
                               Fill="{StaticResource IconAccentBrush}" />
                    <Line X1="12" Y1="0.5" X2="12" Y2="3.5"
                          Stroke="{StaticResource IconAccentBrush}" StrokeThickness="2.4" StrokeEndLineCap="Round" />
                    <Polygon Points="7,3.5 12,8 17,3.5"
                             Fill="{StaticResource IconAccentBrush}" />
                </Canvas>
            </Grid>
        </Viewbox>
    </Button>

</ResourceDictionary>

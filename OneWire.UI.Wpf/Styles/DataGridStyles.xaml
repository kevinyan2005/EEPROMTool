<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <system:Double x:Key="AppFontSize" xmlns:system="clr-namespace:System;assembly=mscorlib">14</system:Double>

    <!-- Implicit styles — apply to every instance of these types app-wide -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AppFontSize}"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="{StaticResource AppFontSize}"/>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="FontSize" Value="{StaticResource AppFontSize}"/>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="FontSize" Value="{StaticResource AppFontSize}"/>
    </Style>

</ResourceDictionary>